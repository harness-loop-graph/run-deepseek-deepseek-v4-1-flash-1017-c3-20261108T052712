# Medical Appointments & Clinical History — local configuration template.
#
#   cp .env.example .env && docker compose up -d --build
#
# Every variable below has a working default, so `docker compose up` works
# without a `.env`. Copy this file only to override values. Never commit the
# resulting `.env` (RF-26).

# ---------------------------------------------------------------------------
# Compose / general
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------------------
# Database (db service, PostgreSQL 16)
# Fixed local defaults from the delivery contract.
# ---------------------------------------------------------------------------
POSTGRES_USER=medapp
POSTGRES_PASSWORD=medapp
POSTGRES_DB=medapp
# Host port mapped to 5432 in the container (fixed by the contract).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (http://localhost:3000)
# DATABASE_URL is composed by docker-compose.yml from the POSTGRES_* values.
# ---------------------------------------------------------------------------
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Deterministic seed (RF-05): password for every seeded user.
# Users: admin@seed.local, staff@seed.local, paciente1..3@seed.local,
#        gomez@seed.local, lopez@seed.local
# ---------------------------------------------------------------------------
SEED_PASSWORD=Seed!Passw0rd

# ---------------------------------------------------------------------------
# OAuth 2.0 authorization code + PKCE (RF-07, RF-08)
# The client id and redirect URI are fixed by the specification.
# ---------------------------------------------------------------------------
OAUTH_CLIENT_ID=medapp-spa
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
# Local development only. Set a long random value in any shared environment.
TOKEN_SECRET=local-development-token-secret-change-me

# ---------------------------------------------------------------------------
# Attachments (RF-17): PDF/JPEG/PNG, 5 MB per file, stored outside any
# publicly served directory.
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# CORS and rate limiting (RF-14)
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_BOOKING_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Frontend (http://localhost:8080, static build)
# Values baked into the SPA bundle at build time.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
